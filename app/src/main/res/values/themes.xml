<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TodoApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/daisy_light_primary</item>
        <item name="colorOnPrimary">@color/daisy_light_primary_content</item>
        <item name="colorSecondary">@color/daisy_light_secondary</item>
        <item name="colorOnSecondary">@color/daisy_light_secondary_content</item>
        <item name="colorTertiary">@color/daisy_light_accent</item>
        <item name="colorOnTertiary">@color/daisy_light_accent_content</item>
        <item name="android:colorBackground">@color/daisy_light_base_300</item>
        <item name="colorOnBackground">@color/daisy_light_base_content</item>
        <item name="colorSurface">@color/daisy_light_base_100</item>
        <item name="colorOnSurface">@color/daisy_light_base_content</item>
        <item name="colorPrimaryContainer">@color/daisy_light_primary</item>
        <item name="colorOnPrimaryContainer">@color/daisy_light_primary_content</item>
        <item name="colorSecondaryContainer">@color/daisy_light_secondary</item>
        <item name="colorOnSecondaryContainer">@color/daisy_light_secondary_content</item>
        <item name="colorTertiaryContainer">@color/daisy_light_accent</item>
        <item name="colorOnTertiaryContainer">@color/daisy_light_accent_content</item>
        <item name="colorSurfaceVariant">@color/daisy_light_base_200</item>
        <item name="colorOnSurfaceVariant">@color/daisy_light_base_content</item>
        <item name="colorSurfaceContainer">@color/daisy_light_base_100</item>

        <item name="colorError">@color/daisy_light_error</item>
        <item name="colorOnError">@color/daisy_light_error_content</item>
    </style>

    <style name="Theme.TodoApp" parent="Base.Theme.TodoApp" />

    <style name="Widget.TodoApp.PaginationButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/selector_pagination_page_bg</item>
        <item name="android:textColor">@color/selector_pagination_page_text</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <style name="Widget.TodoApp.PaginationButton.Nav">
        <item name="backgroundTint">@color/selector_pagination_nav_bg</item>
        <item name="android:textColor">@color/selector_pagination_nav_text</item>
    </style>

    <style name="ThemeOverlay.TodoApp.SearchBar" parent="">
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorControlActivated">?attr/colorOnSurface</item>
    </style>
</resources>